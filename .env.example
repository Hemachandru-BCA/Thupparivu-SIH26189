# SentinelGraph AI - environment configuration
# Copy to .env and fill in ONLY what you need. The demo requires NONE of these.

# ------------------------------------------------------------------ API ----
# Comma-separated CORS origins for the React frontend.
# Local dev (Vite):  http://localhost:5173
# Production (GitHub Pages):  https://YOUR_USERNAME.github.io
# Example: CORS_ORIGINS=http://localhost:5173,https://yourusername.github.io
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Request body size guard (bytes)
SENTINELGRAPH_MAX_UPLOAD_BYTES=2097152
# Graph query guard: default max nodes returned by subgraph extraction
SENTINELGRAPH_MAX_NODES=5000
# Log level for the API
SENTINELGRAPH_LOG_LEVEL=INFO

# ------------------------------------------------------------------ LLM ----
# Optional: enables the OpenAI-compatible dossier provider.
# If unset, the deterministic offline MockLLMProvider is used (recommended
# for the demo; requires no credentials).
# SENTINELGRAPH_LLM_API_KEY=
# Optional Google AI fallback key, used only after a quota/rate-limit response.
# SENTINELGRAPH_LLM_API_KEY_FALLBACK=
# SENTINELGRAPH_LLM_BASE_URL=https://api.openai.com/v1
# SENTINELGRAPH_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------- PostgreSQL ----
# Optional SourceRepository adapter (psycopg v3). Disabled unless set.
# SENTINELGRAPH_PG_DSN=postgresql://user:pass@localhost:5432/sentinelgraph
# SENTINELGRAPH_PG_TABLE=source_records

# ------------------------------------------------------------------ S3 ----
# Optional DocumentStore adapter (boto3). Disabled unless set.
# SENTINELGRAPH_S3_BUCKET=
# AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the
# standard AWS credential chain - never put keys in this file.

# --------------------------------------------------------------- Kafka ----
# Optional EventStream adapter (confluent-kafka). Disabled unless set.
# SENTINELGRAPH_KAFKA_BOOTSTRAP=localhost:9092

# --------------------------------------------------------------- Neo4j ----
# Optional GraphStore adapter (neo4j driver). Disabled unless set.
# SENTINELGRAPH_NEO4J_URI=neo4j://localhost:7687
# SENTINELGRAPH_NEO4J_USER=neo4j
# SENTINELGRAPH_NEO4J_PASSWORD=

# ------------------------------------------------------------- Airflow ----
# Used by the example DAG (src/adapters/airflow_dags/) only.
# SENTINELGRAPH_ROOT=/opt/sentinelgraph-ai
# SENTINELGRAPH_PYTHON=python3
