# Frontend environment variables (all PUBLIC — compiled into the bundle)

# Backend API base URL used in production.
# For local development leave empty so the Vite proxy forwards /api to the dev backend.
#   VITE_API_BASE_URL=http://localhost:8000
#
# Production Railway backend:
VITE_API_BASE_URL=https://thupparivu-sih26189-production.up.railway.app
VITE_API_URL=https://thupparivu-sih26189-production.up.railway.app

# Base path for the app when hosted in a subdirectory (GitHub Pages).
# Leave empty ('/') for local dev or a root domain.
# For GitHub Pages set to the repository name, e.g.:
#   BASE_PATH=/Thupparivu-SIH26189
# (Set automatically by the GitHub Actions deploy workflow.)
